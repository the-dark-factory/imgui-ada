--  GPR project file for the imgui-ada bindings.
--
--  This file compiles the Ada side of the binding. Linking to
--  libcimgui is the responsibility of the consuming crate (or
--  the example projects under examples/). v1 keeps the build
--  artefact a static library so the consumer decides how to
--  pull in the C library.

library project Df_Imgui is

   for Library_Name use "imgui_ada";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";

   --  Pass these to anyone with-ing this project so the C++ side
   --  links correctly. cimgui is built by scripts/build-cimgui.sh
   --  into vendor/cimgui/libcimgui.a.
   --
   --  The -syslibroot is macOS-specific (the Alire-shipped gcc
   --  needs to be told where the Xcode SDK lives). On Linux the
   --  c++ runtime is found automatically; that branch isn't
   --  active here yet but will be once cross-platform testing
   --  lands.
   package Linker is
      for Linker_Options use
        ("-L" & Project'Project_Dir & "vendor/cimgui",
         "-lcimgui",
         "-Wl,-syslibroot,/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk",
         "-lc++");
   end Linker;

   package Compiler is
      for Default_Switches ("ada") use
        ("-gnatwa",       --  all warnings
         "-gnaty",        --  default style checks
         "-gnatVa",       --  all validity checks
         "-O0",
         "-g");
   end Compiler;

end Df_Imgui;
