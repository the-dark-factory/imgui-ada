--  Root GPR for the df_imgui bindings — standard Alire library project
--  (the shape `alr init --lib` generates).
--
--  The Ada binding (src/) is the library; the cimgui + Dear ImGui C++ it wraps
--  is compiled by the companion cimgui.gpr (a separate project to avoid an
--  imgui.ads / imgui.cpp object-name clash). Because this project `with`s
--  cimgui.gpr, `alr build` compiles both and a consumer that `with`s df_imgui
--  links the C++ library too — self-contained, no pre-build script, nothing
--  platform-hardcoded.
with "config/df_imgui_config.gpr";
with "cimgui.gpr";
project Df_Imgui is

   for Library_Name use "imgui_ada";
   for Library_Version use Project'Library_Name & ".so." & Df_Imgui_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Df_Imgui_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("DF_IMGUI_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Df_Imgui_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Df_Imgui;
