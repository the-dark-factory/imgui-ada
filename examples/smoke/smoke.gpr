--  Headless smoke test for df_imgui.
--
--  Builds against the in-tree df_imgui binding, which `with`s cimgui.gpr —
--  so the C++ library (and its runtime) are pulled in by gprbuild. Nothing
--  to pre-build or hand-link. Run `gprbuild -P examples/smoke/smoke.gpr`
--  from the repo root, then ./examples/smoke/bin/smoke.

with "../../df_imgui.gpr";

project Smoke is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("smoke.adb");

   package Compiler is
      for Default_Switches ("ada") use
        ("-gnatwa", "-gnatVa", "-O0", "-g");
   end Compiler;

end Smoke;
